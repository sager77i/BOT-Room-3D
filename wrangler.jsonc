{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bot-room-3d",
  "compatibility_date": "2026-10-23",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "."
  },
  "workers_dev": true,
  "routes": [
    {
      "pattern": "sager.app/*",
      "zone_name": "sager.app"
    }
  ]
}
